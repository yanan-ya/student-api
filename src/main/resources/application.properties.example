# 复制本文件为 application.properties，填入你自己的数据库信息
spring.datasource.url=jdbc:mysql://localhost:3306/student_system?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
spring.datasource.username=你的数据库用户名
spring.datasource.password=你的数据库密码
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

server.port=8081
